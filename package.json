{
	"name": "svelte-check-action",
	"version": "1.6.0",
	"private": true,
	"exports": {
		".": "./dist/index.js"
	},
	"scripts": {
		"build": "tsup src/index.ts --clean --format cjs",
		"check": "biome check && prettier --check .",
		"fix": "prettier --write . && biome check --write",
		"release": "pnpm build && git diff --exit-code --stat dist && changelogen --release",
		"test": "vitest"
	},
	"devDependencies": {
		"@actions/core": "3.0.1",
		"@actions/github": "9.1.1",
		"@biomejs/biome": "2.4.15",
		"@types/node": "24.12.4",
		"@types/picomatch": "4.0.3",
		"changelogen": "0.6.2",
		"date-fns": "4.3.0",
		"nanoexec": "1.1.0",
		"picomatch": "4.0.4",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "4.0.1",
		"tsup": "8.5.1",
		"typescript": "6.0.3",
		"valibot": "1.4.0",
		"vitest": "4.1.7"
	},
	"packageManager": "pnpm@10.33.4",
	"volta": {
		"node": "24.16.0",
		"pnpm": "10.33.4"
	}
}
